{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomige",
  "compatibility_date": "2026-09-25",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
}
