{
  "include": ["src/**/*"],
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "paths": {
      "~/*": ["../app/*"]
    }
  }
}
